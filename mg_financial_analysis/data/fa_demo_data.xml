<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Jeu de démonstration : 3 périodes comparées -->

        <record id="demo_partner" model="res.partner">
            <field name="name">SOCIETE MALAGASY DE DISTRIBUTION (DEMO)</field>
            <field name="is_company" eval="True"/>
            <field name="city">Antananarivo</field>
            <field name="street">Lot II M 45 Bis, Analakely</field>
        </record>

        <record id="demo_analysis" model="fa.analysis">
            <field name="partner_id" ref="demo_partner"/>
            <field name="sector_id" ref="sector_commerce"/>
            <field name="activity_mode">mixed</field>
            <field name="nif">3000123456</field>
            <field name="stat">46900 11 2018 0 12345</field>
            <field name="scale">unit</field>
            <field name="show_gross" eval="True"/>
            <field name="state">progress</field>
            <field name="note" type="html"><![CDATA[<p>Mission d'analyse financiere portant sur trois periodes : les exercices 2024 et 2025 puis le premier semestre 2026. Societe de distribution de produits de grande consommation implantee a Antananarivo. L'objectif est d'apprecier la trajectoire financiere sur la periode et d'identifier les leviers de redressement.</p>]]></field>
        </record>

        <record id="demo_stmt_2024" model="fa.statement">
            <field name="name">Exercice 2024</field>
            <field name="analysis_id" ref="demo_analysis"/>
            <field name="period_type">annual</field>
            <field name="date_from">2024-01-01</field>
            <field name="date_to">2024-12-31</field>
            <field name="is_audited" eval="True"/>
        </record>

        <record id="demo_stmt_2025" model="fa.statement">
            <field name="name">Exercice 2025</field>
            <field name="analysis_id" ref="demo_analysis"/>
            <field name="period_type">annual</field>
            <field name="date_from">2025-01-01</field>
            <field name="date_to">2025-12-31</field>
            <field name="is_audited" eval="True"/>
            <field name="previous_statement_id" ref="demo_stmt_2024"/>
        </record>

        <record id="demo_stmt_s1_2026" model="fa.statement">
            <field name="name">S1 2026</field>
            <field name="analysis_id" ref="demo_analysis"/>
            <field name="period_type">semester</field>
            <field name="date_from">2026-01-01</field>
            <field name="date_to">2026-06-30</field>
            <field name="previous_statement_id" ref="demo_stmt_2025"/>
            <field name="seasonality_note">Activite de distribution presentant une saisonnalite moderee : le second semestre represente historiquement 55 pour cent du chiffre d'affaires annuel. L'annualisation du premier semestre sous-estime donc legerement l'activite annuelle attendue.</field>
        </record>

