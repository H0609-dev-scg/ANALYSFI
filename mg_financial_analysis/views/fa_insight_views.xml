<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fa_ratio_insight_tree" model="ir.ui.view">
        <field name="name">fa.ratio.insight.tree</field>
        <field name="model">fa.ratio.insight</field>
        <field name="arch" type="xml">
            <tree create="0" delete="0" default_order="sequence"
                  decoration-danger="severity == 'alert'"
                  decoration-warning="severity == 'watch'"
                  decoration-success="severity == 'ok'">
                <field name="sequence" invisible="1"/>
                <field name="statement_id" optional="hide"/>
                <field name="kind"/>
                <field name="family" optional="show"/>
                <field name="severity" widget="badge"
                       decoration-danger="severity == 'alert'"
                       decoration-warning="severity == 'watch'"
                       decoration-success="severity == 'ok'"/>
                <field name="name"/>
                <field name="message"/>
                <field name="ratio_codes" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_fa_ratio_insight_form" model="ir.ui.view">
        <field name="name">fa.ratio.insight.form</field>
        <field name="model">fa.ratio.insight</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <field name="statement_id"/>
                        <field name="kind"/>
                        <field name="family"/>
                        <field name="severity"/>
                        <field name="ratio_codes"/>
                    </group>
                    <group>
                        <field name="name"/>
                        <field name="message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fa_ratio_insight_search" model="ir.ui.view">
        <field name="name">fa.ratio.insight.search</field>
        <field name="model">fa.ratio.insight</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="statement_id"/>
                <filter name="alert" string="Points d'attention"
                        domain="[('severity','=','alert')]"/>
                <filter name="cross" string="Lectures croisées"
                        domain="[('kind','=','cross')]"/>
                <group expand="1" string="Regrouper par">
                    <filter name="g_kind" string="Type" context="{'group_by': 'kind'}"/>
                    <filter name="g_fam" string="Famille" context="{'group_by': 'family'}"/>
                    <filter name="g_stmt" string="Période" context="{'group_by': 'statement_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fa_ratio_insight" model="ir.actions.act_window">
        <field name="name">Lecture des ratios</field>
        <field name="res_model">fa.ratio.insight</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_g_kind': 1}</field>
    </record>
</odoo>
