<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fa_analysis_tree" model="ir.ui.view">
        <field name="name">fa.analysis.tree</field>
        <field name="model">fa.analysis</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'done'" decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="sector_id"/>
                <field name="date_mission"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="statement_count" string="Périodes"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'progress'"
                       decoration-success="state == 'done'"/>
                <field name="currency_id" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_fa_analysis_kanban" model="ir.ui.view">
        <field name="name">fa.analysis.kanban</field>
        <field name="model">fa.analysis</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="statement_count"/>
                <field name="user_id"/>
                <field name="sector_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="partner_id"/></strong>
                                    <small class="o_kanban_record_subtitle text-muted">
                                        <field name="name"/>
                                    </small>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <span class="badge rounded-pill"><field name="sector_id"/></span>
                                <div class="mt-1">
                                    <i class="fa fa-file-text-o" title="Périodes"/>
                                    <t t-esc="record.statement_count.value"/> période(s)
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left"/>
                                <div class="oe_kanban_bottom_right">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_fa_analysis_form" model="ir.ui.view">
        <field name="name">fa.analysis.form</field>
        <field name="model">fa.analysis</field>
        <field name="arch" type="xml">
            <form string="Dossier d'analyse financière">
                <header>
                    <button name="action_start" string="Démarrer la mission" type="object"
                            class="oe_highlight" states="draft"/>
                    <button name="action_print_comparison" string="Rapport comparatif PDF"
                            type="object" class="oe_highlight" states="progress,done"
                            help="Génère le comparatif de toutes les périodes et imprime le rapport."/>
                    <button name="action_generate_comparison" string="Générer le comparatif"
                            type="object" class="oe_highlight" states="progress,done"
                            help="Compare les deux périodes les plus récentes avec annualisation des flux."/>
                    <button name="action_done" string="Finaliser" type="object" states="progress"/>
                    <button name="action_draft" string="Réouvrir" type="object" states="done"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_statements" type="object" class="oe_stat_button"
                                icon="fa-file-text-o">
                            <field name="statement_count" widget="statinfo" string="Périodes"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Client">
                            <field name="partner_id" options="{'no_quick_create': True}"/>
                            <field name="sector_id" options="{'no_create_edit': True}"/>
                            <field name="activity_mode"/>
                            <field name="nif"/>
                            <field name="stat"/>
                            <field name="rcs"/>
                        </group>
                        <group string="Paramètres de la mission">
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="date_mission"/>
                            <field name="currency_id" options="{'no_create': True}"/>
                            <field name="scale"/>
                            <field name="show_gross"/>
                            <field name="tolerance"/>
                            <field name="sr_method"/>
                            <field name="sr_include_taxes"
                                   attrs="{'invisible': [('sr_method','=','variable')]}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert"
                         attrs="{'invisible': [('sector_description','=',False)]}">
                        <strong>Caractéristiques du secteur</strong>
                        <field name="sector_description" nolabel="1" readonly="1"/>
                        <div class="mt-2">
                            <button name="action_view_sector_norms" type="object"
                                    string="Voir les normes de ce secteur"
                                    class="btn-link p-0" icon="fa-sliders"/>
                            (<field name="sector_norm_count" readonly="1" nolabel="1"
                                    class="oe_inline"/> ratio(s) avec seuils spécifiques)
                        </div>
                    </div>

                    <notebook>
                        <page string="Périodes analysées" name="statements">
                            <field name="statement_ids" nolabel="1"
                                   context="{'default_analysis_id': active_id}">
                                <tree decoration-danger="not is_balanced"
                                      decoration-success="state == 'analyzed'">
                                    <field name="name"/>
                                    <field name="period_type"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="duration_months" string="Mois"/>
                                    <field name="total_asset" widget="monetary"/>
                                    <field name="net_result_pl" string="Résultat net" widget="monetary"/>
                                    <field name="is_balanced" string="Équilibré" widget="boolean_toggle"/>
                                    <field name="state" widget="badge"/>
                                    <field name="currency_id" invisible="1"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Comparatifs" name="comparisons">
                            <field name="comparison_ids" nolabel="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="statement_count" string="Nb périodes"/>
                                    <field name="statement_ids" widget="many2many_tags"
                                           string="Périodes comparées"/>
                                    <field name="mode"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Options du rapport" name="report_options">
                            <div class="alert alert-info" role="alert">
                                Ces réglages pilotent le contenu des rapports imprimés
                                (PDF d'une période et comparatif multi-périodes).
                                Ils n'affectent pas l'affichage à l'écran : les
                                recommandations restent consultables dans le module
                                même si vous les excluez du livrable.
                            </div>
                            <group>
                                <group string="Recommandations">
                                    <field name="report_show_recommendations"/>
                                    <field name="report_reco_scope"
                                           attrs="{'invisible': [('report_show_recommendations','=',False)],
                                                   'required': [('report_show_recommendations','=',True)]}"/>
                                    <field name="report_show_reco_summary"
                                           attrs="{'invisible': [('report_show_recommendations','=',False)]}"/>
                                </group>
                                <group string="Explications et annexes">
                                    <field name="report_show_interpretation"/>
                                    <field name="report_show_formula"
                                           attrs="{'invisible': [('report_show_interpretation','=',False)]}"/>
                                    <field name="report_show_equity"/>
                                    <field name="report_show_cashflow"/>
                                    <field name="report_show_cashflow_direct"
                                           attrs="{'invisible': [('report_show_cashflow','=',False)]}"/>
                                    <field name="report_show_score"/>
                                    <field name="report_show_glossary"/>
                                </group>
                            </group>
                            <group string="Ratios exclus du rapport">
                                <div colspan="2">
                                    <field name="report_hidden_count" readonly="1"
                                           class="oe_inline"/>
                                    ratio(s) sont masqués dans les rapports de la dernière
                                    période.
                                    <button name="action_view_hidden_ratios" type="object"
                                            string="Les consulter" class="btn-link p-0"
                                            attrs="{'invisible': [('report_hidden_count','=',0)]}"/>
                                    <div class="text-muted mt-1">
                                        Le masquage d'un ratio se règle période par période,
                                        dans l'onglet « Ratios &amp; recommandations ».
                                    </div>
                                </div>
                            </group>
                        </page>

                        <page string="Contexte de la mission" name="context">
                            <field name="note" nolabel="1"
                                   placeholder="Objet de la mission, historique du client, marché, événements marquants de la période, sources des données..."/>
                        </page>
                        <page string="Conclusion générale" name="conclusion">
                            <button name="action_generate_conclusion" type="object"
                                    string="Générer un projet de conclusion"
                                    class="btn-primary mb-2" icon="fa-magic"
                                    help="Rédige un premier jet à partir des indicateurs calculés. À relire et compléter."/>
                            <div class="text-muted mb-2">
                                Le texte généré s'appuie uniquement sur les chiffres :
                                complétez-le avec les éléments qualitatifs du dossier
                                (marché, gouvernance, projets, événements postérieurs
                                à la clôture).
                            </div>
                            <field name="conclusion" nolabel="1"
                                   placeholder="Synthèse rédigée par le consultant, reprise en fin de rapport."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_fa_analysis_search" model="ir.ui.view">
        <field name="name">fa.analysis.search</field>
        <field name="model">fa.analysis</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="sector_id"/>
                <filter name="my" string="Mes dossiers" domain="[('user_id','=',uid)]"/>
                <separator/>
                <filter name="draft" string="Brouillon" domain="[('state','=','draft')]"/>
                <filter name="progress" string="En cours" domain="[('state','=','progress')]"/>
                <filter name="done" string="Finalisé" domain="[('state','=','done')]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_partner" string="Client" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_sector" string="Secteur" context="{'group_by': 'sector_id'}"/>
                    <filter name="group_user" string="Consultant" context="{'group_by': 'user_id'}"/>
                    <filter name="group_state" string="État" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fa_analysis" model="ir.actions.act_window">
        <field name="name">Dossiers d'analyse</field>
        <field name="res_model">fa.analysis</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créer un dossier d'analyse financière</p>
            <p>Un dossier regroupe les états financiers d'un même client sur plusieurs périodes.</p>
        </field>
    </record>

</odoo>
