<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ SECTEURS ============ -->
    <record id="view_fa_sector_tree" model="ir.ui.view">
        <field name="name">fa.sector.tree</field>
        <field name="model">fa.sector</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="norm_count" string="Normes définies"/>
                <field name="active" widget="boolean_toggle" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_fa_sector_form" model="ir.ui.view">
        <field name="name">fa.sector.form</field>
        <field name="model">fa.sector</field>
        <field name="arch" type="xml">
            <form string="Secteur d'activité">
                <header>
                    <button name="action_calibrate" type="object"
                            string="Calibrer sur mon portefeuille"
                            class="oe_highlight"
                            help="Calcule les quartiles observés sur vos dossiers déjà analysés de ce secteur et propose de les convertir en seuils."/>
                    <button name="action_duplicate_norms" type="object"
                            string="Copier les normes d'un autre secteur"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_norms" type="object" class="oe_stat_button"
                                icon="fa-sliders">
                            <field name="norm_count" widget="statinfo" string="Normes"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivé" bg_color="bg-danger"
                            attrs="{'invisible': [('active','=',True)]}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Ex. Commerce / Négoce"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Caractéristiques financières du secteur">
                        <field name="description" nolabel="1"
                               placeholder="Intensité capitalistique, longueur du cycle d'exploitation, saisonnalité, structure de marge... Ce texte est repris en tête du rapport d'analyse."/>
                    </group>
                    <notebook>
                        <page string="Normes de ratios" name="norms">
                            <div class="alert alert-warning" role="alert">
                                <strong>Origine des seuils livrés avec le module.</strong>
                                Ce sont des références professionnelles générales, ajustées au
                                secteur par appréciation d'expert. Elles ne proviennent
                                <strong>pas</strong> de statistiques officielles malgaches,
                                aucune base de ratios sectoriels publique n'étant disponible
                                pour Madagascar. Utilisez le bouton
                                <em>Calibrer sur mon portefeuille</em> dès que vous aurez
                                traité plusieurs dossiers du secteur : vos propres données
                                constituent la référence locale la plus fiable.
                            </div>
                            <div class="alert alert-info" role="alert">
                                Les seuils définis ici <strong>remplacent</strong> les seuils
                                génériques du ratio pour les clients rattachés à ce secteur.
                                Les ratios non listés conservent leurs seuils génériques.
                            </div>
                            <field name="norm_ids" nolabel="1"
                                   context="{'default_sector_id': active_id}">
                                <tree editable="bottom">
                                    <field name="ratio_id" options="{'no_create': True}"/>
                                    <field name="ratio_family" string="Famille" readonly="1"/>
                                    <field name="unit" string="Unité" readonly="1"/>
                                    <field name="direction" string="Sens" readonly="1"/>
                                    <field name="threshold_bad" string="Critique"/>
                                    <field name="threshold_watch" string="Vigilance"/>
                                    <field name="threshold_good" string="Confort"/>
                                    <field name="threshold_max" string="Borne haute" optional="hide"/>
                                    <field name="norm_label" string="Norme affichée"/>
                                    <field name="sector_median" string="Médiane secteur"/>
                                    <field name="comment" string="Précision sectorielle"
                                           optional="show"/>
                                    <field name="source" string="Origine du seuil"/>
                                    <field name="source_note" string="Référence" optional="hide"/>
                                    <field name="sample_size" string="Éch." optional="hide"/>
                                    <field name="last_calibration" string="Calibré le"
                                           optional="hide"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fa_sector" model="ir.actions.act_window">
        <field name="name">Secteurs d'activité</field>
        <field name="res_model">fa.sector</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Définir un secteur d'activité</p>
            <p>Chaque secteur porte ses propres seuils de ratios : ce qui est
               satisfaisant en négoce ne l'est pas en industrie.</p>
        </field>
    </record>

    <!-- ============ NORMES SECTORIELLES ============ -->
    <record id="view_fa_sector_norm_tree" model="ir.ui.view">
        <field name="name">fa.sector.norm.tree</field>
        <field name="model">fa.sector.norm</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sector_id" options="{'no_create': True}"/>
                <field name="ratio_id" options="{'no_create': True}"/>
                <field name="ratio_code" string="Code" readonly="1"/>
                <field name="ratio_family" string="Famille" readonly="1"/>
                <field name="direction" string="Sens" readonly="1"/>
                <field name="threshold_bad" string="Critique"/>
                <field name="threshold_watch" string="Vigilance"/>
                <field name="threshold_good" string="Confort"/>
                <field name="norm_label" string="Norme affichée"/>
                <field name="sector_median" string="Médiane"/>
                <field name="comment" string="Précision" optional="show"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_fa_sector_norm_form" model="ir.ui.view">
        <field name="name">fa.sector.norm.form</field>
        <field name="model">fa.sector.norm</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="sector_id" options="{'no_create': True}"/>
                            <field name="ratio_id" options="{'no_create': True}"/>
                            <field name="ratio_family" readonly="1"/>
                            <field name="unit" readonly="1"/>
                            <field name="direction" readonly="1"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="threshold_bad"/>
                            <field name="threshold_watch"/>
                            <field name="threshold_good"/>
                            <field name="threshold_max"
                                   attrs="{'invisible': [('direction','!=','range')]}"/>
                            <field name="norm_label"/>
                            <field name="sector_median"/>
                        </group>
                    </group>
                    <group string="Précision sectorielle ajoutée au commentaire">
                        <field name="comment" nolabel="1"
                               placeholder="Ex. « Compte tenu des délais d'importation, un stock de 60 jours reste acceptable en négoce. »"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fa_sector_norm_search" model="ir.ui.view">
        <field name="name">fa.sector.norm.search</field>
        <field name="model">fa.sector.norm</field>
        <field name="arch" type="xml">
            <search>
                <field name="sector_id"/>
                <field name="ratio_id"/>
                <field name="ratio_code"/>
                <group expand="1" string="Regrouper par">
                    <filter name="g_sector" string="Secteur" context="{'group_by': 'sector_id'}"/>
                    <filter name="g_family" string="Famille" context="{'group_by': 'ratio_family'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fa_sector_norm" model="ir.actions.act_window">
        <field name="name">Normes sectorielles</field>
        <field name="res_model">fa.sector.norm</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_g_sector': 1}</field>
    </record>

    <!-- ============ ASSISTANT DE COPIE ============ -->
    <record id="view_fa_sector_norm_copy_form" model="ir.ui.view">
        <field name="name">fa.sector.norm.copy.form</field>
        <field name="model">fa.sector.norm.copy</field>
        <field name="arch" type="xml">
            <form string="Copier les normes">
                <group>
                    <field name="source_sector_id" options="{'no_create': True}"/>
                    <field name="target_sector_id" options="{'no_create': True}"/>
                    <field name="overwrite"/>
                </group>
                <footer>
                    <button name="action_copy" string="Copier" type="object" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
