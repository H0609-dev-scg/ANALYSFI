<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fa_extra_check_tree" model="ir.ui.view">
        <field name="name">fa.extra.check.tree</field>
        <field name="model">fa.extra.check</field>
        <field name="arch" type="xml">
            <tree create="0" delete="0" edit="0"
                  decoration-danger="severity == 'error'"
                  decoration-warning="severity == 'warning'"
                  decoration-muted="severity == 'info'">
                <field name="currency_id" invisible="1"/>
                <field name="statement_id"/>
                <field name="severity" widget="badge"
                       decoration-danger="severity == 'error'"
                       decoration-warning="severity == 'warning'"/>
                <field name="name" string="Donnée"/>
                <field name="value_entered" string="Saisi" widget="monetary"/>
                <field name="value_expected" string="Attendu" widget="monetary"/>
                <field name="message" string="Constat"/>
                <field name="suggestion" string="Que faire"/>
                <field name="impact" string="Ratios impactés" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_fa_extra_check_search" model="ir.ui.view">
        <field name="name">fa.extra.check.search</field>
        <field name="model">fa.extra.check</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="statement_id"/>
                <filter name="errors" string="Incohérences"
                        domain="[('severity','=','error')]"/>
                <filter name="warnings" string="À vérifier"
                        domain="[('severity','=','warning')]"/>
                <group expand="1" string="Regrouper par">
                    <filter name="g_stmt" string="Période"
                            context="{'group_by':'statement_id'}"/>
                    <filter name="g_sev" string="Niveau"
                            context="{'group_by':'severity'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fa_extra_check" model="ir.actions.act_window">
        <field name="name">Contrôles de saisie</field>
        <field name="res_model">fa.extra.check</field>
        <field name="view_mode">tree</field>
        <field name="context">{'search_default_g_stmt': 1}</field>
    </record>
</odoo>
