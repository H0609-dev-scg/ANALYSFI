<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fa_import_wizard_form" model="ir.ui.view">
        <field name="name">fa.import.wizard.form</field>
        <field name="model">fa.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importer la saisie">
                <group attrs="{'invisible': [('state','!=','upload')]}">
                    <field name="statement_id" options="{'no_create': True}"/>
                    <field name="file_data" filename="file_name"/>
                    <field name="file_name" invisible="1"/>
                    <field name="overwrite"/>
                    <field name="import_previous"/>
                    <field name="import_gross"/>
                    <div class="text-muted" colspan="2">
                        CSV (point-virgule) ou Excel. Première colonne : code de
                        rubrique (AC_STOCK, PL_VENTE_MSE…). Le fichier produit par
                        l'export Excel du module est accepté tel quel.
                    </div>
                    <field name="state" invisible="1"/>
                </group>
                <group attrs="{'invisible': [('state','!=','preview')]}">
                    <group>
                        <field name="nb_matched"/>
                        <field name="nb_unknown"/>
                        <field name="nb_apply"/>
                    </group>
                    <group>
                        <field name="overwrite"/>
                        <field name="import_previous"/>
                        <field name="import_gross"/>
                    </group>
                </group>
                <field name="line_ids" nolabel="1"
                       attrs="{'invisible': [('state','!=','preview')]}">
                    <tree editable="bottom" create="0" delete="0"
                          decoration-muted="status != 'ok'"
                          decoration-danger="status == 'unknown'"
                          decoration-success="apply">
                        <field name="sequence" invisible="1"/>
                        <field name="apply"/>
                        <field name="code" readonly="1"/>
                        <field name="name" readonly="1"/>
                        <field name="status" readonly="1"/>
                        <field name="current_net" readonly="1"/>
                        <field name="amount_net"/>
                        <field name="amount_gross" optional="hide"/>
                        <field name="amount_deprec" optional="hide"/>
                        <field name="amount_previous" optional="show"/>
                    </tree>
                </field>
                <div attrs="{'invisible': [('state','!=','done')]}">
                    <field name="summary" nolabel="1" readonly="1"/>
                </div>
                <footer>
                    <button name="action_preview" string="Aperçu" type="object"
                            class="btn-primary"
                            attrs="{'invisible': [('state','!=','upload')]}"/>
                    <button name="action_download_template" string="Télécharger le modèle"
                            type="object"
                            attrs="{'invisible': [('state','!=','upload')]}"/>
                    <button name="action_apply" string="Importer" type="object"
                            class="btn-primary"
                            attrs="{'invisible': [('state','!=','preview')]}"/>
                    <button name="action_open_statement" string="Ouvrir la période"
                            type="object" class="btn-primary"
                            attrs="{'invisible': [('state','!=','done')]}"/>
                    <button string="Fermer" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fa_import_wizard" model="ir.actions.act_window">
        <field name="name">Importer la saisie</field>
        <field name="res_model">fa.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_fa_statement"/>
        <field name="binding_view_types">form</field>
        <field name="context">{'default_statement_id': active_id}</field>
    </record>
</odoo>
