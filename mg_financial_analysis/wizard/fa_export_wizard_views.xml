<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fa_export_wizard_form" model="ir.ui.view">
        <field name="name">fa.export.wizard.form</field>
        <field name="model">fa.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Excel">
                <group attrs="{'invisible': [('state','=','done')]}">
                    <field name="statement_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <field name="include_input"/>
                    <field name="include_aggregates"/>
                    <field name="include_ratios"/>
                    <field name="include_interpretation"
                           attrs="{'invisible': [('include_ratios','=',False)]}"/>
                    <field name="include_recommendations"
                           attrs="{'invisible': [('include_ratios','=',False)]}"/>
                    <field name="include_glossary"
                           attrs="{'invisible': [('include_ratios','=',False)]}"/>
                    <field name="respect_hidden"
                           attrs="{'invisible': [('include_ratios','=',False)]}"/>
                    <field name="state" invisible="1"/>
                </group>
                <div attrs="{'invisible': [('state','!=','done')]}" class="text-center">
                    <p>Le fichier est prêt.</p>
                    <field name="file_data" filename="file_name" readonly="1"/>
                    <field name="file_name" invisible="1"/>
                </div>
                <footer>
                    <button name="action_export" string="Générer" type="object"
                            class="btn-primary" attrs="{'invisible': [('state','=','done')]}"/>
                    <button string="Fermer" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fa_export_wizard" model="ir.actions.act_window">
        <field name="name">Exporter en Excel</field>
        <field name="res_model">fa.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_fa_statement"/>
        <field name="binding_view_types">list,form</field>
    </record>
</odoo>
